<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default Material 3 light theme (no custom color overrides) -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar" />

    <style name="ToolbarTitleCompact" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Dialog theme aligned with default Material 3 (same palette as AppTheme) -->
    <style name="AppDialogTheme" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
